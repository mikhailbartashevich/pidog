[Unit]
Description=PiDog AI HAT+ 2 Russian Voice Command Bridge
After=network-online.target pidog-hailo-ollama.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pidog-voice-ai-hat2
EnvironmentFile=-/etc/pidog-voice-ai-hat2.env
Environment=SDL_AUDIODRIVER=dummy
ExecStartPre=/usr/bin/env robot_hat disable_speaker
ExecStart=/usr/bin/python3 /opt/pidog-voice-ai-hat2/pidog_voice_server.py --host 0.0.0.0 --port 8765
ExecStopPost=-/usr/bin/env robot_hat disable_speaker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
