# Copy to /etc/pidog-voice-ai-hat2.env and replace the token.
PIDOG_TOKEN=replace-with-a-long-random-token
PIDOG_USER=pi
PIDOG_VOICE_LANGUAGE=ru
PIDOG_ALSA_DEVICE=robothat

# Hailo-10H backend. It must stay loopback-only.
PIDOG_LLM_URL=http://127.0.0.1:8000
PIDOG_LLM_READY_PATH=/hailo/v1/list
PIDOG_LLM_NAME=qwen2:1.5b
PIDOG_LLM_UNIT=pidog-hailo-ollama.service
PIDOG_SYSTEMD_SCOPE=system

# Optional, if the PiDog sound files are outside the usual PiDog checkout.
# PIDOG_SOUND_DIR=/home/pi/pidog/sounds
# Optional web search overrides:
# BRAVE_SEARCH_API_KEY=...
# PIDOG_SEARXNG_URL=https://your-searxng.example
