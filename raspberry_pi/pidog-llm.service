[Unit]
Description=PiDog Local Qwen Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/llama-server --model %h/.local/share/pidog-llm/models/Qwen3.5-0.8B-Q4_0.gguf --host 127.0.0.1 --port 8081 --ctx-size 2048 --threads 4 --threads-batch 4 --batch-size 128 --ubatch-size 64 --parallel 1 --cache-type-k q8_0 --cache-type-v q8_0 --jinja
Restart=on-failure
RestartSec=3
Nice=5
MemoryHigh=2400M
MemoryMax=2800M
OOMPolicy=stop

[Install]
WantedBy=default.target
